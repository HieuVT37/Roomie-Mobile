{
  "expo": {
    "name": "Roomie",
    "slug": "Roomie-Mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/roomie-logo.png",
    "scheme": "roomiemobile",
    "userInterfaceStyle": "light",
    "ios": {
      "icon": "./assets/images/roomie-logo.png",
      "bundleIdentifier": "com.roomie.mobile",
      "supportsTablet": false
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/images/roomie-logo.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.roomie.mobile"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "Cho phép Roomie truy cập ảnh để gửi trong tin nhắn."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
